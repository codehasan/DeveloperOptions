# Copy this file to `keystore.properties` and fill in your own values to
# produce a signed release build. It is gitignored — never commit the real
# file or your .jks keystore.
#
# Debug builds do NOT need this file; it is only read for release signing.
storeFile=your-release-key.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
